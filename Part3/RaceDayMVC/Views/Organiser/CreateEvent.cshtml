@model RaceDayMVC.Models.CreateEventVm
@{
    ViewData["Title"] = "Create Event";
}
<div class="container mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary mb-3">← Back</a>
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"> Create Event</h4>
        </div>
        <div class="card-body">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }
            <form method="post" enctype="multipart/form-data">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label fw-bold">Event Name *</label>
                        <input asp-for="EventName" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Event Type *</label>
                        <select asp-for="EventType" class="form-select">
                            <option value="Run"> Run</option>
                            <option value="Walk"> Walk</option>
                            <option value="Cycle"> Cycle</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Date *</label>
                        <input asp-for="EventDate" type="date" class="form-control" required
                               value="@Model.EventDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Distance (km) *</label>
                        <input asp-for="DistanceKm" type="number" step="0.01" min="0.01"
                               class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Location *</label>
                        <input asp-for="Location" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <hr />
                        <label class="form-label fw-bold"> Event Banner</label>
                        <input asp-for="BannerFile" type="file" class="form-control" accept="image/*" />
                        <div class="form-text">
                            JPG or PNG, max 10MB. Uploaded after the event is
                            created.
                        </div>
                    </div>
                    <div class="col-12 mt-3">
                        <button class="btn btn-primary"> Create Event</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>