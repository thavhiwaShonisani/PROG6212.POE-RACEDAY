@model List<RaceDayMVC.Models.EventVm>
@{ ViewData["Title"] = "Events"; }
<div class="container mt-4">
    <h1 class="fw-bold mb-4"> Upcoming Events</h1>
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <h4>No events yet</h4>
            <p>Check back soon!</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var ev in Model.OrderBy(e => e.EventDate))
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                        {
                            <img src="@ev.BannerImageUrl" class="card-img-top" 
                            style="height:180px;object-fit:cover" alt="@ev.EventName" />
                        }
                        else
                        {
                            <div class="card-img-top bg-primary text-white d-flex align-items-center 
                              justify-content-center" style="height:180px;font-size:4rem">
                                @(ev.EventType == "Run" ? "" : ev.EventType == "Walk" ? "" : "")
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold mb-0">@ev.EventName</h5>
                                <span class="badge bg-@(ev.EventType == "Run" ? "danger" : ev.EventType 
                                  == "Walk" ? "success" : "info")">
                                    @ev.EventType.ToUpper()
                                </span>
                            </div>
                            <p class="text-muted small mb-2">
                                @(
                                                        string.IsNullOrEmpty(ev.Description) ? "No description." :
                                                                                                                                          (ev.Description.Length > 100 ? ev.Description.Substring(0, 100) +
                                                                                                                                            "..." : ev.Description)
                                            )
                                        </p>
                                        <ul class="list-unstyled small mb-3">
                                            <li> @ev.EventDate.ToString("dd MMM yyyy")</li>
                                            <li> @ev.Location</li>
                                            <li> @ev.DistanceKm km</li>
                                            @if (ev.Organiser != null)
                                {
                                    <li> @ev.Organiser.FullName</li>
                                }
                            </ul>
                            <a asp-action="Details" asp-route-id="@ev.EventID" class="btn btn-primary 
                              mt-auto w-100">View Details →</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
     </div>